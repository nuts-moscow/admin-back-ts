{
  "name": "admin-back-ts",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:back": "turbo run dev --filter=@admin/back",
    "dev:web": "turbo run dev --filter=@admin/player-web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "check": "turbo run lint type-check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "latest",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
