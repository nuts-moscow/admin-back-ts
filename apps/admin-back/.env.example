# Required: HS256 key for admin JWT auth (min 32 characters)
JWT_SECRET=qweqweqweqweqweqweqweqweqweqweqwe

# Required: HS256 key for player-app JWT auth (min 32 characters, must differ from JWT_SECRET)
PLAYER_JWT_SECRET=playerplayerplayerplayerplayerpl

# HTTP port the server listens on.
# PORT=3000

# Comma-separated list of allowed browser origins (player-web / admin-ui
# deployments) for CORS. "*" (the default) allows any origin but disables
# credentialed requests. Example: "https://user.nuts.moscow,https://admin.nuts.moscow"
# CORS_ORIGIN=*
# CORS_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
# CORS_HEADERS=Content-Type, Authorization

# Required: Postgres. Either set POSTGRES_URL directly, or set
# POSTGRES_PASSWORD and let the parts below (with their defaults) assemble
# a connection string. No default password — startup fails without one.
# POSTGRES_URL=postgres://nuts-user:password@localhost:5432/nuts-poker
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=nuts-user
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=nuts-poker
# POSTGRES_SSL=true
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Required: Redis. REDIS_DB selects the logical DB index (default 0).
REDIS_URL=redis://:change-me@localhost:6379
# REDIS_DB=0

# Transactional mail — Unisender Go. Leave MAIL_API_TOKEN unset in
# development: codes are then written to the log instead of being sent, so the
# flow runs without a provider account.
#
# The API key also verifies the delivery webhook: Unisender Go signs each
# callback by MD5-ing the body with this key substituted for the signature,
# so there is no separate webhook secret.
MAIL_API_TOKEN=
MAIL_FROM=no-reply@nuts.moscow
MAIL_FROM_NAME=NUTS Family

# Defaults to the go2 datacentre; set only to move the account elsewhere.
# MAIL_API_URL=https://go2.unisender.ru/ru/transactional/api/v1/email/send.json
