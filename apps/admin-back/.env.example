# Required: HS256 key for admin JWT auth (min 32 characters)
JWT_SECRET=qweqweqweqweqweqweqweqweqweqweqwe

# Required: HS256 key for player-app JWT auth (min 32 characters, must differ from JWT_SECRET)
PLAYER_JWT_SECRET=playerplayerplayerplayerplayerpl

# Transactional mail. Unset in development: codes are written to the log
# instead of being sent, so the flow runs without a provider account.
# The provider must offer delivery webhooks — plain SMTP reports only that a
# relay accepted the message, and the failures that matter come after that.
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_FROM=no-reply@localhost

# Shared secret the provider echoes on POST /api/mail/delivery. The webhook
# refuses every request while this is unset.
MAIL_WEBHOOK_SECRET=
